node_modules/
*.log
chat.log
.DS_Store
npm-debug.log*
.superpowers/

.remember/

# Deploy credentials read by src/deploy-notify.js (`loadDeployEnv`): the
# Telegram bot token and chat id. Same rule as any other key in this repo —
# names are documented (.env.example), values never committed.
.env

# Bots (bots/) keep everything they store — state, credentials, the recovery
# key — in ~/.tailchat/bots/<name>/, deliberately outside the checkout. These
# patterns exist only so that pointing TAILCHAT_STATE or TAILCHAT_CREDENTIALS
# back inside the tree cannot end with a password in git.
bots/*.env
bots/*state*
bots/*.recovery

# Android
android/.gradle/
android/build/
android/app/build/
# Kotlin build-tools session scratch, written next to the Gradle project by
# AGP on every compile.
android/.kotlin/
# Absolute SDK path: true only on the machine that wrote it.
android/local.properties
# A signing key does not belong in a repository. android/README.md carries the
# keytool line that recreates it.
android/*.jks

# Installer snapshot generated from the deployed commit by
# bin/production-deploy.js. Kept out of git so it can never go stale.
web/cloud/tailchat.tar.gz

# Signed Trusted Web Activity APK wrapping web/cloud/ (see docs/android-twa.md).
# Built locally with the persistent keystore and uploaded straight to the
# server; never generated by production-deploy.js and never committed, same
# reasoning as the tar.gz above.
web/cloud/tailchat.apk
# Runtime update manifest written and published by release-android.js.
web/cloud/android-version.json

# Rust core build output (crates/, docs/specs/2026-11-01-rust-core.md). The
# root one is rust-analyzer's, written when the editor opens the whole repo.
/crates/target/
/target/
/native/
/web/cloud/core/pkg/
# where bin/release-cloud.js stages the shipped core on the box before the swap
/web/cloud/core/.pkg-*/

# Local-only: editor/agent state, scratch logs and backups that never belong in git.
.claude/
.crates-*/
tmux-*.log
experiments/raven/
/target/
