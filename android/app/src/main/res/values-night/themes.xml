<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tailchat" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0B0F0E</item>
        <item name="android:navigationBarColor">#0B0F0E</item>
        <item name="android:windowBackground">#0B0F0E</item>
    </style>

    <!-- See values/themes.xml for why this exists; only the background
         differs, matching this mode's own windowBackground. -->
    <style name="Theme.Tailchat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tailchat</item>
    </style>
</resources>
